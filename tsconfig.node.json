{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "allowImportingTsExtensions": false
  },
  "include": [
    "src/core/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/cli/**/*",
    "src/server/**/*",
    "src/shared/**/*",
    "electron.vite.config.ts"
  ]
}